# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# ------------------------------------------------------------------
# Configuração pública do app web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > app web)
# Estes valores vão para o navegador; não são segredos, mas identificam o projeto.
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Admin SDK (conta de serviço). SECRETO: só no servidor.
# NUNCA use o prefixo NEXT_PUBLIC nestas variáveis.
# (Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
# A chave privada vai entre aspas, numa linha só, com os \n como estão no arquivo JSON.
# ------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""
