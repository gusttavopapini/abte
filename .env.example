# Modelo das variáveis de ambiente. Copie para .env.local e preencha.
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# ------------------------------------------------------------------
# Configuração pública do app web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > app web)
# Estes valores vão para o navegador; não são segredos, mas identificam o projeto.
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ------------------------------------------------------------------
# Admin SDK (conta de serviço). SECRETO: só no servidor.
# NUNCA use o prefixo NEXT_PUBLIC nestas variáveis.
# (Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada)
# A chave privada vai entre aspas, numa linha só, com os \n como estão no arquivo JSON.
# ------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# ------------------------------------------------------------------
# SÓ PARA TESTES LOCAIS: deixe vazio no .env.local e na hospedagem.
# Com valor (ex.: 127.0.0.1:9099) no momento do build, o login do navegador
# usa o emulador de Authentication em vez do projeto real.
# ------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# ------------------------------------------------------------------
# Pagamento da loja pela Stripe (08/11/2026). SECRETO: só no servidor
# (.env.local e Vercel). Nunca coloque valores aqui.
# PAGAMENTO_HABILITADO=sim liga o "Finalizar compra" no carrinho; vazio, o
# site fica com o "Em breve". Chave sk_test_: modo de teste (nada é
# cobrado). Chave sk_live_: o servidor recusa criar pagamentos, a não ser
# com PAGAMENTO_PRODUCAO_CONFIRMADO=sim.
# STRIPE_WEBHOOK_SECRET: segredo do endpoint
# https://<site>/api/stripe/webhook, criado no painel da Stripe.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAGAMENTO_HABILITADO=
PAGAMENTO_PRODUCAO_CONFIRMADO=
